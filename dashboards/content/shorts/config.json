{
  "title": "Shorts Performance",
  "department_title": "Content",
  "department_icon": "play",
  "icon": "video",
  "description": "Daily Shorts plays across sites.",
  "filters": [
    { "type": "date_range", "column": "date", "label": "Date range" },
    { "type": "multiselect", "column": "site", "label": "Site", "order": ["v1", "mako", "n12"] }
  ],
  "layout": [
    [
      {
        "type": "bar",
        "title": "Plays per day by site",
        "transform": {
          "x": "date",
          "y": "plays",
          "aggfunc": "sum",
          "series": "site",
          "barmode": "stack",
          "stack_order": "sum_desc"
        }
      },
      {
        "type": "bar",
        "title": "Natives + Bumpers per day by site",
        "transform": {
          "x": "date",
          "y_expr": { "sum": ["natives", "bumpers"] },
          "y_label": "natives_plus_bumpers",
          "aggfunc": "sum",
          "series": "site",
          "barmode": "stack",
          "stack_order": "sum_desc"
        }
      }
    ],
    [
      {
        "type": "line",
        "title": "Impressions rate by site",
        "subtitle": "(natives + bumpers) / total plays",
        "transform": {
          "x": "date",
          "y_expr": {
            "ratio": {
              "numerator": { "sum": ["natives", "bumpers"] },
              "denominator": "plays"
            }
          },
          "y_label": "impressions_rate",
          "series": "site"
        }
      }
    ],
    [
      {
        "type": "shorts_funnel",
        "title": "Shorts funnel",
        "subtitle": "From all plays through to impressions, per site"
      }
    ]
  ]
}
